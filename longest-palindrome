function longestPalindrome(s: string): number {
    const freq = new Map<string , number>();

    for(const ch of s)
    {
        freq.set(ch,(freq.get(ch) || 0) + 1);

    }

    let length = 0;
    let hasOdd=false;

    for(const count of freq.values())
    {
        length +=Math.floor(count/2)*2;

        if(count % 2 === 1)
        {
            hasOdd = true;
        }
    }

    return hasOdd ? length + 1 : length;
};
