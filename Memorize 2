5function memoize(fn) {
6    const cache = new Map();
7    
8    return function(...args) {
9        let node = cache;
10
11        for (const arg of args)
12        {
13            if (!node.has(arg))
14            {
15                node.set(arg,new Map());
16            }
17            node = node.get(arg);
18        }
19        if(node.has("result"))
20        {
21            return node.get("result");
22        }
23
24        const result = fn(...args);
25        node.set("result", result);
26
27        return result;
28
29        
30    };
31}
