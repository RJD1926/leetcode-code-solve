class Solution {

    /**
     * @param Integer[] $timeSeries
     * @param Integer $duration
     * @return Integer
     */
    function findPoisonedDuration($timeSeries, $duration) {
        $total = 0;
        $n = count($timeSeries);

        for($i=0;$i<$n-1;$i++)
        {
            $gap = $timeSeries[$i+1]-$timeSeries[$i];
            
            $total+= min($gap,$duration);
        }

        if($n > 0)
        {
            $total+= $duration;
        }

        return $total;
    }
}
